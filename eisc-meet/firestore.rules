rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if ownsUserDoc(uid);
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.participantIds.size() == 1
        && request.resource.data.participantIds[0] == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantIds", "updatedAt"])
          && !(request.auth.uid in resource.data.participantIds)
          && request.auth.uid in request.resource.data.participantIds
          && request.resource.data.participantIds.hasAll(resource.data.participantIds)
          && request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
          && request.resource.data.participantIds.size() <= resource.data.maxParticipants
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.participantIds
          && (
            request.resource.data.role == "member"
            || (
              request.resource.data.role == "owner"
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid
            )
          );
        allow update, delete: if signedIn()
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participantIds;
        allow update, delete: if false;
      }
    }
  }
}
